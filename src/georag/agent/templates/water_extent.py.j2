"""{{ title }}

Generated by GeoRAG from the plan below. Method: monthly median {{ plan.index }} composite from
Sentinel-2 L2A with the SCL cloud mask; water where {{ plan.index }} > {{ plan.threshold }}.
{% if reference %}The JRC Global Surface Water occurrence layer (>= 50 %) is computed on the same grid as a reference.{% endif %}

Plan: {{ plan_json }}
"""

import json

import numpy as np

from georag.geo import eo

BBOX = {{ bbox }}  # lon_min, lat_min, lon_max, lat_max ({{ place }})
MONTH = "{{ periods[0] }}"
INDEX = "{{ plan.index }}"
THRESHOLD = {{ plan.threshold }}

comp = eo.monthly_composite(BBOX, MONTH, INDEX, {{ plan.max_cloud }}, {{ plan.max_scenes }}, {{ plan.resolution }})
mask, stats = eo.water_stats(comp, THRESHOLD)
eo.write_geotiff(f"{INDEX.lower()}_{MONTH}.tif", comp.index, comp.grid, nodata=float("nan"))
eo.write_geotiff(f"water_{MONTH}.tif", mask.astype("uint8"), comp.grid)
result = {"place": "{{ place }}", "bbox": BBOX, **stats}
{% if reference %}
occ, _ = eo.jrc_occurrence(BBOX, comp.grid)
ref = (occ >= 50) & (occ <= 100)
observed = np.isfinite(comp.index)
px_km2 = comp.grid.pixel_area_m2 / 1e6
result["reference_km2"] = round(float(ref.sum() * px_km2), 3)
result["water_km2_observed_only"] = round(float((mask & observed).sum() * px_km2), 3)
inter = (mask & ref & observed).sum()
union = ((mask | ref) & observed).sum()
result["iou_vs_reference"] = round(float(inter / union), 4) if union else None
{% endif %}
eo.figure_index("map.png", comp, "{{ title }}", mask)
layers = eo.web_layers(".", comp, mask)
json.dump({"numbers": result, "layers": layers}, open("result.json", "w"), indent=2)
print(json.dumps(result, indent=2))
